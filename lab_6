import tkinter as tk
import torch
import torch.nn as nn
import numpy as np
import random
from collections import deque

class DQN(nn.Module):
    def __init__(self, input_channels, num_actions):
        super().__init__()
        self.conv = nn.Sequential(
            nn.Conv2d(input_channels, 32, 3, padding=1),
            nn.ReLU(),
            nn.Conv2d(32, 64, 3, padding=1),
            nn.ReLU(),
            nn.Flatten()
        )
        self.fc = nn.Sequential(
            nn.Linear(64 * 8 * 8, 256),
            nn.ReLU(),
            nn.Linear(256, num_actions)
        )

    def forward(self, x):
        return self.fc(self.conv(x))


class DQNAgent:
    def __init__(self, state_shape, num_actions, model_path):
        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        self.policy_net = DQN(state_shape[0], num_actions).to(self.device)
        self.policy_net.load_state_dict(torch.load(model_path, map_location=self.device))
        self.policy_net.eval()
        self.num_actions = num_actions

    def select_action(self, state, valid_moves_indices):
        """Выбор хода без исследования (epsilon=0)"""
        state_t = torch.FloatTensor(state).unsqueeze(0).to(self.device)
        with torch.no_grad():
            q_values = self.policy_net(state_t).cpu().numpy().flatten()
        mask = np.ones(self.num_actions, dtype=bool)
        mask[valid_moves_indices] = False
        q_values[mask] = -np.inf
        return int(np.argmax(q_values))


class MinimaxBot:
    def __init__(self, color, depth=2):
        self.color = color
        self.depth = depth

    def evaluate_board(self, board):
        score = 0
        for r in range(8):
            for c in range(8):
                piece = board[r][c]
                if piece == ' ':
                    continue
                val = 3 if piece.isupper() else 1
                if piece.lower() == 'w':
                    score += val + (8 - r) * 0.1
                else:
                    score -= val + r * 0.1
        return score if self.color == 'w' else -score

    def minimax(self, game, depth, is_maximizing, alpha=float('-inf'), beta=float('inf')):
        if depth == 0 or game.check_game_over():
            return self.evaluate_board(game.board), None

        player = self.color if is_maximizing else ('b' if self.color == 'w' else 'w')
        original_turn = game.current_turn
        game.current_turn = player
        moves = game.get_valid_moves_for_bot()
        game.current_turn = original_turn

        if not moves:
            return self.evaluate_board(game.board), None

        best_move = moves[0]
        if is_maximizing:
            max_eval = float('-inf')
            for move in moves:
                saved_board = [row[:] for row in game.board]
                saved_white = game.white_reserve.copy()
                saved_black = game.black_reserve.copy()
                saved_turn = game.current_turn

                game.current_turn = player
                self._simulate_move(game, move)
                eval_score, _ = self.minimax(game, depth - 1, False, alpha, beta)

                game.board = saved_board
                game.white_reserve = saved_white
                game.black_reserve = saved_black
                game.current_turn = saved_turn

                if eval_score > max_eval:
                    max_eval = eval_score
                    best_move = move
                alpha = max(alpha, eval_score)
                if beta <= alpha:
                    break
            return max_eval, best_move
        else:
            min_eval = float('inf')
            for move in moves:
                saved_board = [row[:] for row in game.board]
                saved_white = game.white_reserve.copy()
                saved_black = game.black_reserve.copy()
                saved_turn = game.current_turn

                game.current_turn = player
                self._simulate_move(game, move)
                eval_score, _ = self.minimax(game, depth - 1, True, alpha, beta)

                game.board = saved_board
                game.white_reserve = saved_white
                game.black_reserve = saved_black
                game.current_turn = saved_turn

                if eval_score < min_eval:
                    min_eval = eval_score
                    best_move = move
                beta = min(beta, eval_score)
                if beta <= alpha:
                    break
            return min_eval, best_move

    def _simulate_move(self, game, move):
        start, end = move
        if start == (None, None):
            r, c = end
            game.board[r][c] = self.color
            if self.color == 'w':
                game.white_reserve.pop()
            else:
                game.black_reserve.pop()
        else:
            sx, sy = start
            ex, ey = end
            piece = game.board[sx][sy]
            game.board[sx][sy] = ' '
            if abs(ex - sx) == 2 or (piece.isupper() and abs(ex - sx) > 1):
                dx = 1 if ex > sx else -1
                dy = 1 if ey > sy else -1
                x, y = sx + dx, sy + dy
                while x != ex and y != ey:
                    if game.board[x][y] != ' ':
                        if game.board[x][y].lower() == self.color:
                            if self.color == 'w':
                                game.white_reserve.append(game.board[x][y])
                            else:
                                game.black_reserve.append(game.board[x][y])
                        game.board[x][y] = ' '
                        break
                    x += dx
                    y += dy
            if (self.color == 'w' and ex == 0) or (self.color == 'b' and ex == 7):
                piece = piece.upper()
            game.board[ex][ey] = piece

    def choose_move(self, game):
        _, best_move = self.minimax(game, self.depth, True)
        return best_move

class CheckersGame:
    def __init__(self, root, use_bot=False):
        self.root = root
        self.root.title("Русские циклические шашки")
        self.use_bot = use_bot
        self.auto_play_mode = False
        self.dqn_vs_minimax = False

        # Игровое поле
        self.game_frame = tk.Frame(root)
        self.game_frame.pack(side=tk.LEFT, padx=10)
        self.canvas = tk.Canvas(self.game_frame, width=400, height=400)
        self.canvas.pack()

        # Резерв
        self.reserve_frame = tk.Frame(root)
        self.reserve_frame.pack(side=tk.LEFT, padx=10)
        self.white_reserve = []
        self.black_reserve = []
        self.placing_from_reserve = False

        self.black_reserve_button = tk.Canvas(self.reserve_frame, width=50, height=50)
        self.black_reserve_button.pack(pady=5)
        self.black_reserve_button.bind("<Button-1>", lambda e: self.start_placing_from_reserve('b'))
        self.white_reserve_button = tk.Canvas(self.reserve_frame, width=50, height=50)
        self.white_reserve_button.pack(pady=5)
        self.white_reserve_button.bind("<Button-1>", lambda e: self.start_placing_from_reserve('w'))
        self.update_reserve_buttons()

        self.board = self.create_board()
        self.selected_piece = None
        self.current_turn = 'w'
        self.undo_button = tk.Button(self.game_frame, text="Отменить", command=self.undo_selection, state=tk.DISABLED)
        self.undo_button.pack()
        self.draw_board()
        self.canvas.bind("<Button-1>", self.click)

        if self.use_bot:
            try:
                self.bot_agent = DQNAgent(state_shape=(5, 8, 8), num_actions=200,
                                          model_path="checkers_dqn.pth")
            except FileNotFoundError:
                tk.messagebox.showwarning(
                    "Модель не найдена",
                    "Файл checkers_dqn.pth отсутствует.\n"
                    "Сначала обучите нейросеть (запустите train_dqn.py).\n"
                    "Игра будет запущена без бота."
                )
                self.use_bot = False

    def get_state_for_bot(self):
        state = np.zeros((5, 8, 8), dtype=np.float32)
        for r in range(8):
            for c in range(8):
                piece = self.board[r][c]
                if piece == 'w':
                    state[0, r, c] = 1.0
                elif piece == 'b':
                    state[1, r, c] = 1.0
                elif piece == 'W':
                    state[2, r, c] = 1.0
                elif piece == 'B':
                    state[3, r, c] = 1.0
        if self.current_turn == 'b':
            state[4, :, :] = len(self.black_reserve) / 12.0
        else:
            state[4, :, :] = len(self.white_reserve) / 12.0
        return state

    def get_valid_moves_for_bot(self):
        moves = []
        for r in range(8):
            for c in range(8):
                piece = self.board[r][c]
                if piece == ' ' or piece.lower() != self.current_turn:
                    continue
                if piece.isupper():  # дамка
                    dirs = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
                    for dr, dc in dirs:
                        for dist in range(1, 8):
                            nr, nc = r + dr * dist, c + dc * dist
                            if 0 <= nr < 8 and 0 <= nc < 8:
                                if self.is_valid_move((r, c), (nr, nc)):
                                    moves.append(((r, c), (nr, nc)))
                            else:
                                break
                else:  # простая шашка
                    fwd = -1 if self.current_turn == 'w' else 1
                    for dc in (-1, 1):
                        nr, nc = r + fwd, c + dc
                        if 0 <= nr < 8 and 0 <= nc < 8:
                            if self.is_valid_move((r, c), (nr, nc)):
                                moves.append(((r, c), (nr, nc)))
                    for direction in (fwd, -fwd):
                        for dc in (-2, 2):
                            nr, nc = r + direction, c + dc // 2
                            tr, tc = r + 2 * direction, c + dc
                            if 0 <= tr < 8 and 0 <= tc < 8:
                                if self.is_valid_move((r, c), (tr, tc)):
                                    moves.append(((r, c), (tr, tc)))
        if not self.must_capture():
            if self.current_turn == 'w' and self.white_reserve:
                start_row, end_row = 4, 8
            elif self.current_turn == 'b' and self.black_reserve:
                start_row, end_row = 0, 4
            else:
                return moves
            for row in range(start_row, end_row):
                for col in range(8):
                    if (row + col) % 2 == 1 and self.board[row][col] == ' ':
                        moves.append(((None, None), (row, col)))
        return moves

    def bot_move(self):
        if not self.use_bot or self.current_turn != 'b':
            return
        state = self.get_state_for_bot()
        moves = self.get_valid_moves_for_bot()
        if not moves:
            return
        valid_indices = list(range(len(moves)))
        action_idx = self.bot_agent.select_action(state, valid_indices)
        start, end = moves[action_idx]
        if start == (None, None):
            self.place_piece_from_reserve(end[0], end[1])
        else:
            self.move_piece(start, end)

    def start_dqn_vs_minimax(self):
        self.new_game()
        self.use_bot = False
        self.auto_play_mode = True
        self.dqn_vs_minimax = True
        self.minimax_bot = MinimaxBot('b', depth=2)
        if not hasattr(self, 'bot_agent') or self.bot_agent is None:
            try:
                self.bot_agent = DQNAgent(state_shape=(5, 8, 8), num_actions=200,
                                          model_path="checkers_dqn.pth")
            except FileNotFoundError:
                tk.messagebox.showwarning("Ошибка", "Файл модели не найден.")
                self.auto_play_mode = False
                return
        self.root.after(500, self.auto_play_step)

    def auto_play_step(self):
        if not self.auto_play_mode or self.check_game_over():
            self.auto_play_mode = False
            return
        if self.current_turn == 'w':
            state = self.get_state_for_bot()
            moves = self.get_valid_moves_for_bot()
            if moves:
                valid_indices = list(range(len(moves)))
                action_idx = self.bot_agent.select_action(state, valid_indices)
                start, end = moves[action_idx]
                if start == (None, None):
                    self.place_piece_from_reserve(end[0], end[1])
                else:
                    self.move_piece(start, end)
            self.root.after(300, self.auto_play_step)
        else:
            best_move = self.minimax_bot.choose_move(self)
            if best_move:
                start, end = best_move
                if start == (None, None):
                    self.place_piece_from_reserve(end[0], end[1])
                else:
                    self.move_piece(start, end)
            self.root.after(300, self.auto_play_step)
    def update_reserve_buttons(self):
        self.white_reserve_button.delete("all")
        self.white_reserve_button.create_oval(5, 5, 45, 45, fill="white")
        self.white_reserve_button.create_text(25, 25, text=str(len(self.white_reserve)))
        self.black_reserve_button.delete("all")
        self.black_reserve_button.create_oval(5, 5, 45, 45, fill="black")
        self.black_reserve_button.create_text(25, 25, text=str(len(self.black_reserve)), fill="white")

    def start_placing_from_reserve(self, color):
        if color == self.current_turn and not self.placing_from_reserve:
            if self.must_capture():
                message_window = tk.Toplevel(self.root)
                message_window.title("Внимание")
                message_window.geometry("300x100")
                label = tk.Label(message_window,
                                 text="Вы обязаны выполнить взятие шашки противника!",
                                 wraplength=250, pady=20)
                label.pack()
                tk.Button(message_window, text="OK", command=message_window.destroy).pack()
                return
            if (color == 'w' and self.white_reserve) or (color == 'b' and self.black_reserve):
                self.placing_from_reserve = True
                self.selected_piece = None
                self.undo_button.config(state=tk.NORMAL)
                self.highlight_available_cells_for_reserve()
                self.draw_board()

    def highlight_available_cells_for_reserve(self):
        self.canvas.delete("highlight")
        start_row = 4 if self.current_turn == 'w' else 0
        end_row = 8 if self.current_turn == 'w' else 4
        for row in range(start_row, end_row):
            for col in range(8):
                if (row + col) % 2 == 1 and self.board[row][col] == ' ':
                    x1 = col * 50
                    y1 = row * 50
                    self.canvas.create_rectangle(x1, y1, x1 + 50, y1 + 50,
                                                 outline="green", width=2, tags="highlight")

    def is_valid_move(self, start, end):
        sx, sy = start
        ex, ey = end
        if self.board[ex][ey] != ' ':
            return False
        dx = ex - sx
        dy = ey - sy
        piece = self.board[sx][sy]
        if piece.isupper():
            if abs(dx) == abs(dy):
                step_x = 1 if dx > 0 else -1
                step_y = 1 if dy > 0 else -1
                x, y = sx + step_x, sy + step_y
                enemy_found = False
                own_piece_found = False
                if self.must_capture():
                    while x != ex and y != ey:
                        if self.board[x][y] != ' ':
                            if enemy_found:
                                return False
                            if self.board[x][y].lower() != self.current_turn:
                                enemy_found = True
                            else:
                                return False
                        x += step_x
                        y += step_y
                    return enemy_found
                else:
                    while x != ex and y != ey:
                        if self.board[x][y] != ' ':
                            if enemy_found or own_piece_found:
                                return False
                            if self.board[x][y].lower() == self.current_turn:
                                own_piece_found = True
                            else:
                                return False
                        x += step_x
                        y += step_y
                    return True
        else:
            if self.must_capture():
                if abs(dx) == 2 and abs(dy) == 2:
                    mx, my = (sx + ex) // 2, (sy + ey) // 2
                    if self.current_turn == 'w' and self.board[mx][my].lower() == 'b':
                        return True
                    if self.current_turn == 'b' and self.board[mx][my].lower() == 'w':
                        return True
                return False
            else:
                if abs(dx) == 2 and abs(dy) == 2:
                    mx, my = (sx + ex) // 2, (sy + ey) // 2
                    if self.board[mx][my].lower() == self.current_turn:
                        return True
                if self.current_turn == 'w' and dx == -1 and abs(dy) == 1:
                    return True
                if self.current_turn == 'b' and dx == 1 and abs(dy) == 1:
                    return True
        return False

    def move_piece(self, start, end):
        sx, sy = start
        ex, ey = end
        if self.is_valid_move(start, end):
            piece = self.board[sx][sy]
            self.board[ex][ey] = self.board[sx][sy]
            self.board[sx][sy] = ' '
            if abs(ex - sx) == 2 or (piece.isupper() and abs(ex - sx) > 1):
                if piece.isupper():
                    dx = 1 if ex > sx else -1
                    dy = 1 if ey > sy else -1
                    x, y = sx + dx, sy + dy
                    while x != ex and y != ey:
                        if self.board[x][y] != ' ':
                            taken_piece = self.board[x][y]
                            if taken_piece.lower() == self.current_turn:
                                if self.current_turn == 'w':
                                    self.white_reserve.append(taken_piece)
                                else:
                                    self.black_reserve.append(taken_piece)
                            self.board[x][y] = ' '
                            self.selected_piece = (ex, ey)
                            if self.can_capture((ex, ey)):
                                self.draw_board()
                                self.update_reserve_buttons()
                                return
                            break
                        x += dx
                        y += dy
                else:
                    mx, my = (sx + ex) // 2, (sy + ey) // 2
                    taken_piece = self.board[mx][my]
                    if taken_piece.lower() == self.current_turn:
                        if self.current_turn == 'w':
                            self.white_reserve.append(taken_piece)
                        else:
                            self.black_reserve.append(taken_piece)
                    self.board[mx][my] = ' '
                    self.selected_piece = (ex, ey)
                    if self.can_capture((ex, ey)):
                        self.draw_board()
                        self.update_reserve_buttons()
                        return
            if (self.current_turn == 'w' and ex == 0) or (self.current_turn == 'b' and ex == 7):
                self.board[ex][ey] = self.board[ex][ey].upper()
            self.selected_piece = None
            self.undo_button.config(state=tk.DISABLED)
            self.switch_turn()
            self.draw_board()
            self.update_reserve_buttons()
            self.check_game_over()
            if self.use_bot and self.current_turn == 'b':
                self.root.after(200, self.bot_move)

    def place_piece_from_reserve(self, row, col):
        start_row = 4 if self.current_turn == 'w' else 0
        end_row = 8 if self.current_turn == 'w' else 4
        if (start_row <= row < end_row and (row + col) % 2 == 1 and self.board[row][col] == ' '):
            self.board[row][col] = self.current_turn
            if self.current_turn == 'w':
                self.white_reserve.pop()
            else:
                self.black_reserve.pop()
            self.placing_from_reserve = False
            self.switch_turn()
            self.draw_board()
            self.update_reserve_buttons()
            self.check_game_over()
            if self.use_bot and self.current_turn == 'b':
                self.root.after(200, self.bot_move)

    def create_board(self):
        board = [[' ' for _ in range(8)] for _ in range(8)]
        for row in range(3):
            for col in range(8):
                if (row + col) % 2 == 1:
                    board[row][col] = 'b'
        for row in range(5, 8):
            for col in range(8):
                if (row + col) % 2 == 1:
                    board[row][col] = 'w'
        return board

    def draw_board(self):
        self.canvas.delete("all")
        for row in range(8):
            for col in range(8):
                x1, y1 = col * 50, row * 50
                x2, y2 = x1 + 50, y1 + 50
                color = "white" if (row + col) % 2 == 0 else "gray"
                self.canvas.create_rectangle(x1, y1, x2, y2, fill=color)
                piece = self.board[row][col]
                if piece != ' ':
                    piece_color = "black" if piece.lower() == 'b' else "white"
                    self.canvas.create_oval(x1 + 5, y1 + 5, x2 - 5, y2 - 5, fill=piece_color)
                    if piece.isupper():
                        self.canvas.create_rectangle(x1 + 15, y1 + 15, x2 - 15, y2 - 15, fill="blue")
        if self.selected_piece:
            self.highlight_moves(self.selected_piece)
        elif self.placing_from_reserve:
            self.highlight_available_cells_for_reserve()

    def highlight_moves(self, pos):
        x, y = pos
        piece = self.board[x][y]
        if piece.isupper():
            if self.must_capture():
                directions = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
                for dx, dy in directions:
                    nx, ny = x + dx, y + dy
                    enemy_found = False
                    while 0 <= nx < 8 and 0 <= ny < 8:
                        if self.board[nx][ny] != ' ':
                            if enemy_found:
                                break
                            if self.board[nx][ny].lower() != self.current_turn:
                                enemy_found = True
                            else:
                                break
                        elif enemy_found:
                            cx, cy = ny * 50 + 25, nx * 50 + 25
                            self.canvas.create_oval(cx - 5, cy - 5, cx + 5, cy + 5, fill="red")
                        nx += dx
                        ny += dy
            else:
                directions = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
                for dx, dy in directions:
                    nx, ny = x + dx, y + dy
                    own_piece_found = False
                    while 0 <= nx < 8 and 0 <= ny < 8:
                        if self.board[nx][ny] != ' ':
                            if own_piece_found:
                                break
                            if self.board[nx][ny].lower() == self.current_turn:
                                own_piece_found = True
                            else:
                                break
                        else:
                            cx, cy = ny * 50 + 25, nx * 50 + 25
                            if own_piece_found:
                                self.canvas.create_oval(cx - 5, cy - 5, cx + 5, cy + 5, fill="yellow")
                            else:
                                self.canvas.create_oval(cx - 5, cy - 5, cx + 5, cy + 5, fill="red")
                        nx += dx
                        ny += dy
        else:
            if self.must_capture():
                directions = [(-2, -2), (-2, 2), (2, -2), (2, 2)]
                for dx, dy in directions:
                    nx, ny = x + dx, y + dy
                    if 0 <= nx < 8 and 0 <= ny < 8 and self.is_valid_move(pos, (nx, ny)):
                        cx, cy = ny * 50 + 25, nx * 50 + 25
                        self.canvas.create_oval(cx - 5, cy - 5, cx + 5, cy + 5, fill="red")
            else:
                directions = [(-2, -2), (-2, 2), (2, -2), (2, 2)]
                for dx, dy in directions:
                    nx, ny = x + dx, y + dy
                    if 0 <= nx < 8 and 0 <= ny < 8:
                        mx, my = (x + nx) // 2, (y + ny) // 2
                        if (0 <= mx < 8 and 0 <= my < 8 and self.board[nx][ny] == ' ' and
                                self.board[mx][my].lower() == self.current_turn):
                            cx, cy = ny * 50 + 25, nx * 50 + 25
                            self.canvas.create_oval(cx - 5, cy - 5, cx + 5, cy + 5, fill="yellow")
                fwd = -1 if self.current_turn == 'w' else 1
                for dc in (-1, 1):
                    nx, ny = x + fwd, y + dc
                    if 0 <= nx < 8 and 0 <= ny < 8 and self.is_valid_move(pos, (nx, ny)):
                        cx, cy = ny * 50 + 25, nx * 50 + 25
                        self.canvas.create_oval(cx - 5, cy - 5, cx + 5, cy + 5, fill="red")

    def click(self, event):
        if self.auto_play_mode:
            return
        col = event.x // 50
        row = event.y // 50
        if 0 <= row < 8 and 0 <= col < 8:
            if self.placing_from_reserve:
                self.place_piece_from_reserve(row, col)
            elif self.selected_piece:
                self.move_piece(self.selected_piece, (row, col))
            elif self.board[row][col].lower() == self.current_turn:
                self.selected_piece = (row, col)
                self.undo_button.config(state=tk.NORMAL)
                self.draw_board()

    def undo_selection(self):
        self.selected_piece = None
        self.placing_from_reserve = False
        self.undo_button.config(state=tk.DISABLED)
        self.draw_board()

    def must_capture(self):
        for row in range(8):
            for col in range(8):
                if self.board[row][col].lower() == self.current_turn:
                    if self.can_capture((row, col)):
                        return True
        return False

    def can_capture(self, pos):
        x, y = pos
        piece = self.board[x][y]
        if piece.isupper():
            directions = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
            for dx, dy in directions:
                nx, ny = x + dx, y + dy
                enemy_found = False
                while 0 <= nx < 8 and 0 <= ny < 8:
                    if self.board[nx][ny] != ' ':
                        if enemy_found:
                            break
                        if self.board[nx][ny].lower() != self.current_turn:
                            next_x, next_y = nx + dx, ny + dy
                            if 0 <= next_x < 8 and 0 <= next_y < 8 and self.board[next_x][next_y] == ' ':
                                return True
                            break
                        else:
                            break
                    nx += dx
                    ny += dy
        else:
            directions = [(-2, -2), (-2, 2), (2, -2), (2, 2)]
            for dx, dy in directions:
                nx, ny = x + dx, y + dy
                if 0 <= nx < 8 and 0 <= ny < 8 and self.board[nx][ny] == ' ':
                    mx, my = x + dx // 2, y + dy // 2
                    if 0 <= mx < 8 and 0 <= my < 8:
                        if self.current_turn == 'w' and self.board[mx][my].lower() == 'b':
                            return True
                        if self.current_turn == 'b' and self.board[mx][my].lower() == 'w':
                            return True
        return False

    def switch_turn(self):
        self.current_turn = 'b' if self.current_turn == 'w' else 'w'

    def has_valid_moves(self):
        for row in range(8):
            for col in range(8):
                if self.board[row][col].lower() == self.current_turn:
                    if self.can_capture((row, col)):
                        return True
                    piece = self.board[row][col]
                    if piece.isupper():
                        dirs = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
                        for dr, dc in dirs:
                            for dist in range(1, 8):
                                nr, nc = row + dr * dist, col + dc * dist
                                if 0 <= nr < 8 and 0 <= nc < 8:
                                    if self.is_valid_move((row, col), (nr, nc)):
                                        return True
                                else:
                                    break
                    else:
                        fwd = -1 if self.current_turn == 'w' else 1
                        for dc in (-1, 1):
                            nr, nc = row + fwd, col + dc
                            if 0 <= nr < 8 and 0 <= nc < 8:
                                if self.is_valid_move((row, col), (nr, nc)):
                                    return True
        if (self.current_turn == 'w' and self.white_reserve) or (self.current_turn == 'b' and self.black_reserve):
            start_row = 4 if self.current_turn == 'w' else 0
            end_row = 8 if self.current_turn == 'w' else 4
            for row in range(start_row, end_row):
                for col in range(8):
                    if (row + col) % 2 == 1 and self.board[row][col] == ' ':
                        return True
        return False

    def check_game_over(self):
        white_pieces = 0
        black_pieces = 0
        for row in range(8):
            for col in range(8):
                piece = self.board[row][col]
                if piece.lower() == 'w':
                    white_pieces += 1
                elif piece.lower() == 'b':
                    black_pieces += 1
        white_pieces += len(self.white_reserve)
        black_pieces += len(self.black_reserve)
        if black_pieces == 0:
            self.show_game_over("Белые шашки выиграли!")
            return True
        elif white_pieces == 0:
            self.show_game_over("Черные шашки выиграли!")
            return True
        if not self.has_valid_moves():
            winner = "Белые" if self.current_turn == 'b' else "Черные"
            self.show_game_over(f"{winner} шашки выиграли!\nУ противника не осталось ходов!")
            return True
        return False

    def show_game_over(self, message):
        game_over_window = tk.Toplevel(self.root)
        game_over_window.title("Игра окончена")
        game_over_window.geometry("400x200")
        game_over_window.transient(self.root)
        game_over_window.grab_set()
        label = tk.Label(game_over_window, text=message, font=("Arial", 14), wraplength=350, pady=30)
        label.pack()
        button_frame = tk.Frame(game_over_window)
        button_frame.pack(pady=20)
        tk.Button(button_frame, text="Новая игра", width=15,
                  command=lambda: self.new_game(game_over_window)).pack(side=tk.LEFT, padx=10)
        tk.Button(button_frame, text="Закрыть", width=15, command=self.quit_game).pack(side=tk.LEFT, padx=10)

    def quit_game(self):
        self.root.quit()
        self.root.destroy()

    def new_game(self, game_over_window=None):
        self.board = self.create_board()
        self.selected_piece = None
        self.current_turn = 'w'
        self.white_reserve = []
        self.black_reserve = []
        self.placing_from_reserve = False
        self.undo_button.config(state=tk.DISABLED)
        self.update_reserve_buttons()
        self.draw_board()
        if game_over_window:
            game_over_window.destroy()


class MenuWindow:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Меню")
        self.root.geometry("300x300")
        button_frame = tk.Frame(self.root)
        button_frame.pack(expand=True)
        tk.Button(button_frame, text="Правила", command=self.show_rules, width=20).pack(pady=10)
        tk.Button(button_frame, text="Играть с другом", command=self.start_game_human, width=20).pack(pady=10)
        tk.Button(button_frame, text="Играть с ботом", command=self.start_game_bot, width=20).pack(pady=10)
        tk.Button(button_frame, text="DQN vs Minimax", command=self.start_dqn_vs_minimax, width=20).pack(pady=10)
        self.root.mainloop()

    def show_rules(self):
        rules_window = tk.Toplevel(self.root)
        rules_window.title("Правила игры")
        rules_window.geometry("800x600")
        text_frame = tk.Frame(rules_window)
        text_frame.pack(expand=True, fill='both', padx=10, pady=10)
        scrollbar = tk.Scrollbar(text_frame)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        text_widget = tk.Text(text_frame, wrap=tk.WORD, yscrollcommand=scrollbar.set)
        text_widget.pack(expand=True, fill='both')
        scrollbar.config(command=text_widget.yview)
        rules_text = """1) Во время партии у игрока есть 3 варианта хода: Тихий ход (то есть,
    движение своей шашки без взятия); Бой шашки соперника; Бой собственной шашки
    (Самовзятие) с дальнейшим введением её в игру.

    2) Бить шашки соперника, поставленные под бой (прямой удар),
    обязательно, а вот брать свои шашки игрок не обязан, но если он начал это делать, то
    должен будет побить все шашки, которые находятся под боем, независимо от того,
    чьи они. Если игрок должен бить чужую шашку и после этого у него появляется
    возможно взять свои шашки, он обязан это сделать.

    3) Если есть возможность бить в нескольких направлениях, то выбор предоставляется 
    берущему. Но если надо выбирать бой либо своей шашки, либо чужой, то сначала надо 
    бить шашку соперника. В случае, если при таком раскладе есть возможность бить по 2 
    и более направлениям, то выбор взятия свободный. При варианте боя либо чужой шашки,
    либо своей, а потом чужой, приоритет отдаётся первому взятию.

    4) Если игроку приходится выбирать между боем 2 чужих шашек, либо чужой и
    своей, то выбирается 1 вариант, но это касается только непосредственного взятия. А если,
    например, у игрока есть возможность взятия, при котором можно побить чужую шашку,
    потом свою, и затем появляется выбор между боем шашки соперника или собственной, то
    выбирает сам бьющий.

    5) В случае, если игрок начинает бить свою шашку, а потом у него появляется
    возможность взять либо чужую, либо свою, также выбирает сам бьющий. Иначе говоря,
    обязанности бить шашку соперника после боя собственной, у игрока нет!

    6) Шашки из "резерва" можно сбрасывать на доску на любом ходу, то есть, если
    "Самовзятие" произошло на 5 ходу, то ввод резервной шашки возможен на 6, 7, 8 и т.д.
    ходу. Единственное ограничение для игрока: сбрасывать "резервиста" можно только в
    пределах 4 горизонталей своей зоны.

    7) По ходу партии может возникнуть ситуация, при которой игрок имеет
    возможность сбить одновременно свою шашку и шашку соперника (или несколько
    каждой из них), что правилами допускается. Свои сбитые шашки при этом уходят в
    "резерв" с дальнейшей возможностью их сброса, а чужие выходят из игры навсегда.

    8) Самосбитая Дамка при уходе в резерв становится простой и только в этом
    качестве может в ходе партии возвратиться в игру. Конечно, чисто практически в такой
    "операции", как правило, нет особого смысла, но всё же ситуации в партии могут
    возникнуть разные. Иногда "замена " Дамки на простую с последующей постановкой её на
    доску может быть единственным способом выигрыша или спасения партии."""
        text_widget.insert(tk.END, rules_text)
        text_widget.config(state=tk.DISABLED)
        tk.Button(rules_window, text="Закрыть", command=rules_window.destroy).pack(pady=10)

    def start_game_human(self):
        self.root.destroy()
        game_root = tk.Tk()
        CheckersGame(game_root, use_bot=False)
        game_root.mainloop()

    def start_game_bot(self):
        self.root.destroy()
        game_root = tk.Tk()
        CheckersGame(game_root, use_bot=True)
        game_root.mainloop()

    def start_dqn_vs_minimax(self):
        self.root.destroy()
        game_root = tk.Tk()
        game = CheckersGame(game_root, use_bot=False)
        game.start_dqn_vs_minimax()
        game_root.mainloop()


class LoginWindow:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Авторизация")
        self.root.geometry("300x200")
        tk.Label(self.root, text="Имя:").pack(pady=5)
        self.username_entry = tk.Entry(self.root)
        self.username_entry.pack(pady=5)
        tk.Label(self.root, text="Пароль:").pack(pady=5)
        self.password_entry = tk.Entry(self.root, show="*")
        self.password_entry.pack(pady=5)
        button_frame = tk.Frame(self.root)
        button_frame.pack(pady=20)
        tk.Button(button_frame, text="Вход", command=self.login).pack(side=tk.LEFT, padx=10)
        tk.Button(button_frame, text="Регистрация", command=self.register).pack(side=tk.LEFT, padx=10)
        self.message_label = tk.Label(self.root, text="", fg="red")
        self.message_label.pack(pady=10)
        self.root.mainloop()

    def register(self):
        username = self.username_entry.get().strip()
        password = self.password_entry.get().strip()
        if not username or not password:
            self.message_label.config(text="Заполните все поля!")
            return
        try:
            with open("accounts.txt", "r", encoding='cp1251') as file:
                for line in file:
                    line = line.strip()
                    if not line:
                        continue
                    parts = line.split(" : ")
                    if len(parts) < 2:
                        continue
                    if parts[0] == username:
                        self.show_warning("Имя пользователя уже существует, введите другое")
                        return
        except FileNotFoundError:
            pass
        except UnicodeDecodeError:
            try:
                with open("accounts.txt", "r", encoding='utf-8') as file:
                    for line in file:
                        line = line.strip()
                        if not line:
                            continue
                        parts = line.split(" : ")
                        if len(parts) < 2:
                            continue
                        if parts[0] == username:
                            self.show_warning("Имя пользователя уже существует, введите другое")
                            return
            except FileNotFoundError:
                pass
        try:
            with open("accounts.txt", "a", encoding='cp1251') as file:
                file.write(f"{username} : {password}\n")
            self.show_info("Данные сохранены, нажмите кнопку 'Вход'")
            self.message_label.config(text="")
        except Exception as e:
            self.message_label.config(text=f"Ошибка при регистрации: {str(e)}")

    def login(self):
        username = self.username_entry.get().strip()
        password = self.password_entry.get().strip()
        if not username or not password:
            self.message_label.config(text="Заполните все поля!")
            return
        for encoding in ['cp1251', 'utf-8']:
            try:
                with open("accounts.txt", "r", encoding=encoding) as file:
                    for line in file:
                        line = line.strip()
                        if not line:
                            continue
                        parts = line.split(" : ")
                        if len(parts) < 2:
                            continue
                        stored_user, stored_pass = parts[0], parts[1]
                        if stored_user == username and stored_pass == password:
                            self.root.quit()
                            self.root.destroy()
                            MenuWindow()
                            return
            except FileNotFoundError:
                continue
            except UnicodeDecodeError:
                continue
        self.show_error("Имя или пароль введены не правильно")

    def show_warning(self, msg):
        w = tk.Toplevel(self.root)
        w.title("Внимание")
        w.geometry("300x100")
        tk.Label(w, text=msg, wraplength=250, pady=20).pack()
        tk.Button(w, text="OK", command=w.destroy).pack()

    def show_info(self, msg):
        w = tk.Toplevel(self.root)
        w.title("Информация")
        w.geometry("300x100")
        tk.Label(w, text=msg, wraplength=250, pady=20).pack()
        tk.Button(w, text="OK", command=w.destroy).pack()

    def show_error(self, msg):
        w = tk.Toplevel(self.root)
        w.title("Ошибка")
        w.geometry("300x100")
        tk.Label(w, text=msg, wraplength=250, pady=20).pack()
        tk.Button(w, text="OK", command=w.destroy).pack()


