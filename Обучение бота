import numpy as np
import random
from collections import deque
import torch
import torch.nn as nn
import torch.optim as optim

class RussianCheckersEnv:
    def __init__(self):
        self.board = np.zeros((8, 8), dtype=np.int8)
        self.current_player = 1   # 1-белые, 2-чёрные
        self.reserves = {1: 0, 2: 0}
        self.done = False
        self.reset()

    def reset(self):
        self.board = np.zeros((8, 8), dtype=np.int8)
        for r in range(3):
            for c in range(8):
                if (r + c) % 2 != 0:
                    self.board[r][c] = 1
        for r in range(5, 8):
            for c in range(8):
                if (r + c) % 2 != 0:
                    self.board[r][c] = 2
        self.current_player = 1
        self.reserves = {1: 0, 2: 0}
        self.done = False
        return self.get_state()

    def get_state(self):
        s = np.zeros((5, 8, 8), dtype=np.float32)
        for r in range(8):
            for c in range(8):
                v = self.board[r][c]
                if v == 1:       s[0, r, c] = 1.0
                elif v == 2:     s[1, r, c] = 1.0
                elif v == 3:     s[2, r, c] = 1.0
                elif v == 4:     s[3, r, c] = 1.0
        s[4, :, :] = self.reserves[self.current_player] / 12.0
        return s

    def _piece_color(self, piece):
        if piece in (1, 3): return 1
        if piece in (2, 4): return 2
        return None

    def _is_king(self, piece):
        return piece in (3, 4)

    def _forward(self, player):
        return 1 if player == 1 else -1

    def get_valid_moves(self):
        moves = []
        player = self.current_player
        enemy = 3 - player
        fwd = self._forward(player)
        for r in range(8):
            for c in range(8):
                piece = self.board[r][c]
                if piece == 0 or self._piece_color(piece) != player:
                    continue
                if self._is_king(piece):
                    for dr, dc in [(1,1),(1,-1),(-1,1),(-1,-1)]:
                        for dist in range(1, 8):
                            nr, nc = r + dr*dist, c + dc*dist
                            if not (0 <= nr < 8 and 0 <= nc < 8): break
                            target = self.board[nr][nc]
                            if target == 0:
                                moves.append({'start':(r,c), 'end':(nr,nc),
                                              'captures':[], 'reserve_add':0, 'promote':False})
                            else:
                                if self._piece_color(target) == enemy:
                                    br, bc = nr+dr, nc+dc
                                    if 0 <= br < 8 and 0 <= bc < 8 and self.board[br][bc] == 0:
                                        moves.append({'start':(r,c), 'end':(br,bc),
                                                      'captures':[(nr,nc)], 'reserve_add':0, 'promote':False})
                                break
                else:
                    for dc in (-1, 1):
                        nr, nc = r + fwd, c + dc
                        if 0 <= nr < 8 and 0 <= nc < 8 and self.board[nr][nc] == 0:
                            moves.append({'start':(r,c), 'end':(nr,nc),
                                          'captures':[], 'reserve_add':0,
                                          'promote': (nr == 0 or nr == 7)})
                    for dc in (-2, 2):
                        nr, nc = r + 2*fwd, c + dc
                        if not (0 <= nr < 8 and 0 <= nc < 8): continue
                        mr, mc = r + fwd, c + dc//2
                        mid = self.board[mr][mc]
                        if mid == 0: continue
                        if self._piece_color(mid) == enemy:
                            moves.append({'start':(r,c), 'end':(nr,nc),
                                          'captures':[(mr,mc)], 'reserve_add':0,
                                          'promote': (nr == 0 or nr == 7)})
                        elif self._piece_color(mid) == player:
                            moves.append({'start':(r,c), 'end':(nr,nc),
                                          'captures':[(mr,mc)], 'reserve_add':1,
                                          'promote': (nr == 0 or nr == 7)})
        cap_moves = [m for m in moves if m['captures']]
        if cap_moves:
            enemy_caps = [m for m in cap_moves if any(self._piece_color(self.board[rr][cc]) == enemy for rr,cc in m['captures'])]
            if enemy_caps:
                cap_moves = enemy_caps
            max_cap = max(len(m['captures']) for m in cap_moves)
            cap_moves = [m for m in cap_moves if len(m['captures']) == max_cap]
            return cap_moves
        return moves

    def step(self, action):
        valid = self.get_valid_moves()
        if not valid:
            self.done = True
            reward = -1 if self.current_player == 1 else 1
            return self.get_state(), reward, self.done
        move = valid[action]
        r0, c0 = move['start']
        r1, c1 = move['end']
        piece = self.board[r0][c0]
        self.board[r0][c0] = 0
        for cr, cc in move['captures']:
            self.board[cr][cc] = 0
        if move['reserve_add'] > 0:
            self.reserves[self.current_player] += move['reserve_add']
        if move['promote']:
            piece = 3 if self.current_player == 1 else 4
        self.board[r1][c1] = piece
        self.current_player = 3 - self.current_player
        enemy_moves = self.get_valid_moves()
        if not enemy_moves:
            self.done = True
            reward = 1 if self.current_player == 1 else -1
        else:
            reward = 0
        return self.get_state(), reward, self.done

class DQN(nn.Module):
    def __init__(self, input_channels, num_actions):
        super().__init__()
        self.conv = nn.Sequential(
            nn.Conv2d(input_channels, 32, 3, padding=1),
            nn.ReLU(),
            nn.Conv2d(32, 64, 3, padding=1),
            nn.ReLU(),
            nn.Flatten()
        )
        self.fc = nn.Sequential(
            nn.Linear(64 * 8 * 8, 256),
            nn.ReLU(),
            nn.Linear(256, num_actions)
        )

    def forward(self, x):
        return self.fc(self.conv(x))

class DQNAgent:
    def __init__(self, state_shape, num_actions):
        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        self.policy_net = DQN(state_shape[0], num_actions).to(self.device)
        self.target_net = DQN(state_shape[0], num_actions).to(self.device)
        self.target_net.load_state_dict(self.policy_net.state_dict())
        self.optimizer = optim.Adam(self.policy_net.parameters(), lr=1e-4)
        self.memory = deque(maxlen=20000)
        self.batch_size = 64
        self.gamma = 0.99
        self.epsilon = 1.0
        self.epsilon_min = 0.01
        self.epsilon_decay = 0.9995
        self.num_actions = num_actions

    def select_action(self, state, valid_indices):
        if random.random() < self.epsilon:
            return random.choice(valid_indices)
        state_t = torch.FloatTensor(state).unsqueeze(0).to(self.device)
        with torch.no_grad():
            q_values = self.policy_net(state_t).cpu().numpy().flatten()
        mask = np.ones(self.num_actions, dtype=bool)
        mask[valid_indices] = False
        q_values[mask] = -np.inf
        return int(np.argmax(q_values))

    def store(self, state, action, reward, next_state, done):
        self.memory.append((state, action, reward, next_state, done))

    def train(self):
        if len(self.memory) < self.batch_size:
            return
        batch = random.sample(self.memory, self.batch_size)
        states, actions, rewards, next_states, dones = zip(*batch)
        states = torch.FloatTensor(np.array(states)).to(self.device)
        actions = torch.LongTensor(actions).unsqueeze(1).to(self.device)
        rewards = torch.FloatTensor(rewards).unsqueeze(1).to(self.device)
        next_states = torch.FloatTensor(np.array(next_states)).to(self.device)
        dones = torch.FloatTensor(dones).unsqueeze(1).to(self.device)

        q_values = self.policy_net(states).gather(1, actions)
        next_q = self.target_net(next_states).max(1)[0].unsqueeze(1)
        target_q = rewards + (1 - dones) * self.gamma * next_q

        loss = nn.MSELoss()(q_values, target_q)
        self.optimizer.zero_grad()
        loss.backward()
        self.optimizer.step()

        if self.epsilon > self.epsilon_min:
            self.epsilon *= self.epsilon_decay

    def update_target(self):
        self.target_net.load_state_dict(self.policy_net.state_dict())

if __name__ == "__main__":
    env = RussianCheckersEnv()
    agent = DQNAgent((5, 8, 8), 200)
    episodes = 5000
    for ep in range(episodes):
        state = env.reset()
        total_reward = 0
        while not env.done:
            moves = env.get_valid_moves()
            if not moves: break
            valid_indices = list(range(len(moves)))
            action = agent.select_action(state, valid_indices)
            next_state, reward, done = env.step(action)
            agent.store(state, action, reward, next_state, done)
            agent.train()
            state = next_state
            total_reward += reward
        agent.update_target()
        if ep % 100 == 0:
            print(f"Episode {ep:4d} | Reward: {total_reward:+3.0f} | Epsilon: {agent.epsilon:.3f}")
    torch.save(agent.policy_net.state_dict(), "checkers_dqn.pth")
    print("Модель сохранена в checkers_dqn.pth")
