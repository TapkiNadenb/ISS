import random
import math
import time
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans

random.seed(42)

cities = [{'id': i, 'name': f'Город_{i + 1}', 'x': random.randint(0, 100), 'y': random.randint(0, 100)} for i in range(15)]

#Евклидово
def distance(city1, city2):
    return math.sqrt((city1['x'] - city2['x']) ** 2 + (city1['y'] - city2['y']) ** 2)

print("ГОРОДА:")
for city in cities:
    print(f"  {city['name']}: ({city['x']}, {city['y']})")
print()

#Алгоритмический
K_alg = 5
print(f"АЛГОРИТМИЧЕСКИЙ МЕТОД (K = {K_alg})")
def calculate_wcss_alg(clusters, centroids):
    wcss = 0
    for i, cluster in enumerate(clusters):
        for city in cluster:
            dist = distance(city, centroids[i])
            wcss += dist ** 2
    return wcss

start_time = time.time()
random_centroids = random.sample(cities, K_alg)
print("Случайные центроиды:")
for i, cent in enumerate(random_centroids):
    print(f"  Кластер {i + 1}: {cent['name']} ({cent['x']}, {cent['y']})")
print()

clusters_alg = [[] for _ in range(K_alg)]
for city in cities:
    min_dist = float('inf')
    closest = 0
    for i, cent in enumerate(random_centroids):
        dist = distance(city, cent)
        if dist < min_dist:
            min_dist = dist
            closest = i
    clusters_alg[closest].append(city)

print("Кластеры:")
for i, cluster in enumerate(clusters_alg):
    print(f"\nКластер {i + 1} (центроид: {random_centroids[i]['name']}):")
    for city in cluster:
        dist = distance(city, random_centroids[i])
        print(f"  {city['name']} ({city['x']}, {city['y']}) -> расстояние: {dist:.2f}")

alg_time = time.time() - start_time
wcss_alg = calculate_wcss_alg(clusters_alg, random_centroids)
print(f"\nВремя выполнения: {alg_time:.6f} секунд")
print(f"WCSS: {wcss_alg:.2f}")
print()

# Определение оптимального K методом «локтя»
X = [[c['x'], c['y']] for c in cities]
max_k = min(14, len(cities))
wcss_vals = []
for k in range(1, max_k + 1):
    km = KMeans(n_clusters=k, random_state=42, max_iter=10, tol=0.0001)
    km.fit(X)
    wcss_vals.append(km.inertia_)

# Локоть
def find_elbow(wcss):
    n = len(wcss)
    if n < 3:
        return 1
    x1, y1 = 1, wcss[0]
    x2, y2 = n, wcss[-1]
    d = []
    for i, y in enumerate(wcss, start=1):
        num = abs((x2 - x1) * (y1 - y) - (x1 - i) * (y2 - y1))
        den = math.sqrt((x2 - x1)**2 + (y2 - y1)**2)
        d.append(num / den if den != 0 else 0)
    return d.index(max(d)) + 1

optimal_k = find_elbow(wcss_vals)
print(f"Оптимальное K для K‑средних: {optimal_k}\n")

def calculate_wcss_kmeans(clusters, centroids_coords):
    wcss = 0
    for i, cluster in enumerate(clusters):
        for city in cluster:
            dist = math.sqrt((city['x'] - centroids_coords[i][0]) ** 2 +
                             (city['y'] - centroids_coords[i][1]) ** 2)
            wcss += dist ** 2
    return wcss

print(f"РУЧНОЙ МЕТОД K‑СРЕДНИХ (K = {optimal_k}):")
start_time = time.time()

centroids_kmeans = random.sample(cities, optimal_k)
centroids_coords_manual = [[c['x'], c['y']] for c in centroids_kmeans]

for iteration in range(20):
    clusters_kmeans_manual = [[] for _ in range(optimal_k)]
    for city in cities:
        min_dist = float('inf')
        closest = 0
        for i, cent in enumerate(centroids_coords_manual):
            dist = math.sqrt((city['x'] - cent[0]) ** 2 + (city['y'] - cent[1]) ** 2)
            if dist < min_dist:
                min_dist = dist
                closest = i
        clusters_kmeans_manual[closest].append(city)

    new_centroids = []
    for cluster in clusters_kmeans_manual:
        if cluster:
            avg_x = sum(c['x'] for c in cluster) / len(cluster)
            avg_y = sum(c['y'] for c in cluster) / len(cluster)
            new_centroids.append([avg_x, avg_y])
        else:
            new_centroids.append([0, 0])

    changed = False
    for i in range(optimal_k):
        if (abs(new_centroids[i][0] - centroids_coords_manual[i][0]) > 0.0001 or
                abs(new_centroids[i][1] - centroids_coords_manual[i][1]) > 0.0001):
            changed = True
            break

    centroids_coords_manual = new_centroids
    if not changed:
        print(f"Сошлось на итерации {iteration + 1}")
        break

print("Финальные центроиды:")
for i, cent in enumerate(centroids_coords_manual):
    print(f"  Кластер {i + 1}: ({cent[0]:.2f}, {cent[1]:.2f})")
print()

print("Кластеры:")
for i, cluster in enumerate(clusters_kmeans_manual):
    print(f"\nКластер {i + 1}:")
    print(f"  Центроид: ({centroids_coords_manual[i][0]:.2f}, {centroids_coords_manual[i][1]:.2f})")
    print(f"  Города:")
    for city in cluster:
        dist = math.sqrt((city['x'] - centroids_coords_manual[i][0]) ** 2 + (city['y'] - centroids_coords_manual[i][1]) ** 2)
        print(f"    {city['name']} ({city['x']}, {city['y']}) -> расстояние: {dist:.2f}")

manual_kmeans_time = time.time() - start_time
wcss_manual = calculate_wcss_kmeans(clusters_kmeans_manual, centroids_coords_manual)
print(f"\nВремя выполнения: {manual_kmeans_time:.6f} секунд")
print(f"WCSS: {wcss_manual:.2f}")
print()

print(f"БИБЛИОТЕЧНЫЙ МЕТОД K‑СРЕДНИХ (K = {optimal_k}):")
start_time = time.time()

kmeans_sk = KMeans(n_clusters=optimal_k, random_state=42, max_iter=20, tol=0.0001)
kmeans_sk.fit(X)

labels_sk = kmeans_sk.labels_
centroids_sk = kmeans_sk.cluster_centers_
clusters_sk = [[] for _ in range(optimal_k)]
for city, label in zip(cities, labels_sk):
    clusters_sk[label].append(city)

print("Финальные центроиды:")
for i, cent in enumerate(centroids_sk):
    print(f"  Кластер {i + 1}: ({cent[0]:.2f}, {cent[1]:.2f})")
print()

print("Кластеры:")
for i, cluster in enumerate(clusters_sk):
    print(f"\nКластер {i + 1}:")
    print(f"  Центроид: ({centroids_sk[i][0]:.2f}, {centroids_sk[i][1]:.2f})")
    print(f"  Города:")
    for city in cluster:
        dist = math.sqrt((city['x'] - centroids_sk[i][0]) ** 2 + (city['y'] - centroids_sk[i][1]) ** 2)
        print(f"    {city['name']} ({city['x']}, {city['y']}) -> расстояние: {dist:.2f}")

sklearn_time = time.time() - start_time
wcss_sklearn = kmeans_sk.inertia_
print(f"\nВремя выполнения: {sklearn_time:.6f} секунд")
print(f"WCSS (inertia): {wcss_sklearn:.2f}")
print()

print("СРАВНЕНИЕ МЕТОДОВ:")
print(f"Алгоритмический (K={K_alg}):     {alg_time:.6f} сек, WCSS = {wcss_alg:.2f}")
print(f"Ручной K‑средних (K={optimal_k}):   {manual_kmeans_time:.6f} сек, WCSS = {wcss_manual:.2f}")
print(f"Библиотечный K‑средних (K={optimal_k}): {sklearn_time:.6f} сек, WCSS = {wcss_sklearn:.2f}")

fig, axes = plt.subplots(1, 3, figsize=(20, 6))
colors = ['red', 'blue', 'green', 'orange', 'purple', 'brown', 'pink', 'gray', 'olive', 'cyan']

for i, cluster in enumerate(clusters_alg):
    xs = [city['x'] for city in cluster]
    ys = [city['y'] for city in cluster]
    axes[0].scatter(xs, ys, c=colors[i % len(colors)], label=f'Кластер {i+1}', alpha=0.7)
    axes[0].scatter(random_centroids[i]['x'], random_centroids[i]['y'],
                    c='black', marker='X', s=200, edgecolors='white', linewidth=2)
axes[0].set_title(f'Алгоритмический (K={K_alg})')
axes[0].set_xlabel('X'); axes[0].set_ylabel('Y')
axes[0].legend(); axes[0].grid(True, alpha=0.3)

for i, cluster in enumerate(clusters_kmeans_manual):
    xs = [city['x'] for city in cluster]
    ys = [city['y'] for city in cluster]
    axes[1].scatter(xs, ys, c=colors[i % len(colors)], label=f'Кластер {i+1}', alpha=0.7)
    axes[1].scatter(centroids_coords_manual[i][0], centroids_coords_manual[i][1],
                    c='black', marker='X', s=200, edgecolors='white', linewidth=2)
axes[1].set_title(f'Ручной K‑средних (K={optimal_k})')
axes[1].set_xlabel('X'); axes[1].set_ylabel('Y')
axes[1].legend(); axes[1].grid(True, alpha=0.3)

for i, cluster in enumerate(clusters_sk):
    xs = [city['x'] for city in cluster]
    ys = [city['y'] for city in cluster]
    axes[2].scatter(xs, ys, c=colors[i % len(colors)], label=f'Кластер {i+1}', alpha=0.7)
    axes[2].scatter(centroids_sk[i][0], centroids_sk[i][1],
                    c='black', marker='X', s=200, edgecolors='white', linewidth=2)
axes[2].set_title(f'Библиотечный K‑средних (K={optimal_k})')
axes[2].set_xlabel('X'); axes[2].set_ylabel('Y')
axes[2].legend(); axes[2].grid(True, alpha=0.3)

plt.tight_layout()
plt.show()

plt.figure(figsize=(10, 6))
plt.plot(range(1, len(wcss_vals)+1), wcss_vals, 'bo-', linewidth=2, markersize=8)
plt.axvline(x=optimal_k, color='red', linestyle='--', linewidth=2, label=f'Оптимальное K = {optimal_k}')
plt.xlabel('Количество кластеров K')
plt.ylabel('WCSS')
plt.title('Метод "локтя" для автоматического выбора K')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()
