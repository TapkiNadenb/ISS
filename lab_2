import random
import math
import time
import matplotlib.pyplot as plt

random.seed(42)

#город
cities = [{'id': i, 'name': f'Город_{i + 1}', 'x': random.randint(0, 100), 'y': random.randint(0, 100)} for i in
          range(15)]


def distance(city1, city2):
    return math.sqrt((city1['x'] - city2['x']) ** 2 + (city1['y'] - city2['y']) ** 2)


#вывод города
print("ГОРОДА:")
for city in cities:
    print(f"  {city['name']}: ({city['x']}, {city['y']})")
print()

K = 5
print(f"K = {K}")
print()

#алгоритмический метод
def calculate_wcss_alg(clusters, centroids):
    wcss = 0
    for i, cluster in enumerate(clusters):
        for city in cluster:
            dist = distance(city, centroids[i])
            wcss += dist ** 2
    return wcss


#K-средних
def calculate_wcss_kmeans(clusters, centroids_coords):
    wcss = 0
    for i, cluster in enumerate(clusters):
        for city in cluster:
            dist = math.sqrt((city['x'] - centroids_coords[i][0]) ** 2 +
                             (city['y'] - centroids_coords[i][1]) ** 2)
            wcss += dist ** 2
    return wcss

print("АЛГОРИТМИЧЕСКИЙ МЕТОД:")
start_time = time.time()

random_centroids = random.sample(cities, K)
print("Случайные центроиды:")
for i, cent in enumerate(random_centroids):
    print(f"  Кластер {i + 1}: {cent['name']} ({cent['x']}, {cent['y']})")
print()

clusters_alg = [[] for _ in range(K)]
for city in cities:
    min_dist = float('inf')
    closest = 0
    for i, cent in enumerate(random_centroids):
        dist = distance(city, cent)
        if dist < min_dist:
            min_dist = dist
            closest = i
    clusters_alg[closest].append(city)

print("Кластеры:")
for i, cluster in enumerate(clusters_alg):
    print(f"\nКластер {i + 1} (центроид: {random_centroids[i]['name']}):")
    for city in cluster:
        dist = distance(city, random_centroids[i])
        print(f"  {city['name']} ({city['x']}, {city['y']}) -> расстояние: {dist:.2f}")

alg_time = time.time() - start_time
wcss_alg = calculate_wcss_alg(clusters_alg, random_centroids)
print(f"\nВремя выполнения: {alg_time:.6f} секунд")
print(f"WCSS: {wcss_alg:.2f}")
print()

print("МЕТОД K-СРЕДНИХ:")
start_time = time.time()

centroids_kmeans = random.sample(cities, K)
centroids_coords = [[c['x'], c['y']] for c in centroids_kmeans]

for iteration in range(20):
    clusters_kmeans = [[] for _ in range(K)]
    for city in cities:
        min_dist = float('inf')
        closest = 0
        for i, cent in enumerate(centroids_coords):
            dist = math.sqrt((city['x'] - cent[0]) ** 2 + (city['y'] - cent[1]) ** 2)
            if dist < min_dist:
                min_dist = dist
                closest = i
        clusters_kmeans[closest].append(city)

    new_centroids = []
    for cluster in clusters_kmeans:
        if cluster:
            avg_x = sum(c['x'] for c in cluster) / len(cluster)
            avg_y = sum(c['y'] for c in cluster) / len(cluster)
            new_centroids.append([avg_x, avg_y])
        else:
            new_centroids.append([0, 0])

    changed = False
    for i in range(K):
        if (abs(new_centroids[i][0] - centroids_coords[i][0]) > 0.0001 or
                abs(new_centroids[i][1] - centroids_coords[i][1]) > 0.0001):
            changed = True
            break

    centroids_coords = new_centroids
    if not changed:
        print(f"Сошлось на итерации {iteration + 1}")
        break

print("Финальные центроиды:")
for i, cent in enumerate(centroids_coords):
    print(f"  Кластер {i + 1}: ({cent[0]:.2f}, {cent[1]:.2f})")
print()

print("Кластеры:")
for i, cluster in enumerate(clusters_kmeans):
    print(f"\nКластер {i + 1}:")
    print(f"  Центроид: ({centroids_coords[i][0]:.2f}, {centroids_coords[i][1]:.2f})")
    print(f"  Города:")
    for city in cluster:
        dist = math.sqrt((city['x'] - centroids_coords[i][0]) ** 2 + (city['y'] - centroids_coords[i][1]) ** 2)
        print(f"    {city['name']} ({city['x']}, {city['y']}) -> расстояние: {dist:.2f}")

kmeans_time = time.time() - start_time
wcss_kmeans = calculate_wcss_kmeans(clusters_kmeans, centroids_coords)
print(f"\nВремя выполнения: {kmeans_time:.6f} секунд")
print(f"WCSS: {wcss_kmeans:.2f}")
print()

print("СРАВНЕНИЕ МЕТОДОВ:")
print(f"Алгоритмический метод: {alg_time:.6f} сек, WCSS = {wcss_alg:.2f}")
print(f"Метод K-средних: {kmeans_time:.6f} сек, WCSS = {wcss_kmeans:.2f}")
print(f"Разница во времени: {abs(alg_time - kmeans_time):.6f} сек")
print(f"Разница в WCSS: {abs(wcss_alg - wcss_kmeans):.2f}")
if alg_time < kmeans_time:
    print("Алгоритмический метод быстрее")
else:
    print("Метод K-средних быстрее")
if wcss_alg < wcss_kmeans:
    print("Алгоритмический метод качественнее (меньше WCSS)")
else:
    print("Метод K-средних качественнее (меньше WCSS)")

fig, axes = plt.subplots(1, 2, figsize=(14, 6))

colors = ['red', 'blue', 'green', 'orange', 'purple', 'brown', 'pink', 'gray', 'olive', 'cyan']

for i, cluster in enumerate(clusters_alg):
    x_coords = [city['x'] for city in cluster]
    y_coords = [city['y'] for city in cluster]
    axes[0].scatter(x_coords, y_coords, c=colors[i % len(colors)], label=f'Кластер {i + 1}', alpha=0.7)
    cent = random_centroids[i]
    axes[0].scatter(cent['x'], cent['y'], c='black', marker='X', s=200, edgecolors='white', linewidth=2)
axes[0].set_title(f'Алгоритмический метод (время: {alg_time:.5f} с, WCSS: {wcss_alg:.0f})')
axes[0].set_xlabel('X координата')
axes[0].set_ylabel('Y координата')
axes[0].legend()
axes[0].grid(True, alpha=0.3)



for i, cluster in enumerate(clusters_kmeans):
    x_coords = [city['x'] for city in cluster]
    y_coords = [city['y'] for city in cluster]
    axes[1].scatter(x_coords, y_coords, c=colors[i % len(colors)], label=f'Кластер {i + 1}', alpha=0.7)
    axes[1].scatter(centroids_coords[i][0], centroids_coords[i][1], c='black', marker='X', s=200, edgecolors='white',
                    linewidth=2)
axes[1].set_title(f'Метод K-средних (время: {kmeans_time:.5f} с, WCSS: {wcss_kmeans:.0f})')
axes[1].set_xlabel('X координата')
axes[1].set_ylabel('Y координата')
axes[1].legend()
axes[1].grid(True, alpha=0.3)

plt.tight_layout()
plt.show()

k_range = range(1, min(11, len(cities)))
wcss_range = []

for k in k_range:
    temp_centroids = random.sample(cities, k)
    temp_centroids_coords = [[c['x'], c['y']] for c in temp_centroids]

    for _ in range(10):
        temp_clusters = [[] for _ in range(k)]
        for city in cities:
            min_dist = float('inf')
            closest = 0
            for i, cent in enumerate(temp_centroids_coords):
                dist = math.sqrt((city['x'] - cent[0]) ** 2 + (city['y'] - cent[1]) ** 2)
                if dist < min_dist:
                    min_dist = dist
                    closest = i
            temp_clusters[closest].append(city)

        new_coords = []
        for cluster in temp_clusters:
            if cluster:
                avg_x = sum(c['x'] for c in cluster) / len(cluster)
                avg_y = sum(c['y'] for c in cluster) / len(cluster)
                new_coords.append([avg_x, avg_y])
            else:
                new_coords.append([0, 0])

        changed = False
        for i in range(k):
            if (abs(new_coords[i][0] - temp_centroids_coords[i][0]) > 0.0001 or
                    abs(new_coords[i][1] - temp_centroids_coords[i][1]) > 0.0001):
                changed = True
                break
        temp_centroids_coords = new_coords
        if not changed:
            break

    temp_clusters = [[] for _ in range(k)]
    for city in cities:
        min_dist = float('inf')
        closest = 0
        for i, cent in enumerate(temp_centroids_coords):
            dist = math.sqrt((city['x'] - cent[0]) ** 2 + (city['y'] - cent[1]) ** 2)
            if dist < min_dist:
                min_dist = dist
                closest = i
        temp_clusters[closest].append(city)

    wcss = 0
    for i, cluster in enumerate(temp_clusters):
        for city in cluster:
            dist = math.sqrt((city['x'] - temp_centroids_coords[i][0]) ** 2 +
                             (city['y'] - temp_centroids_coords[i][1]) ** 2)
            wcss += dist ** 2
    wcss_range.append(wcss)

fig, ax = plt.subplots(figsize=(10, 6))
ax.plot(list(k_range), wcss_range, 'bo-', linewidth=2, markersize=8)
ax.set_xlabel('Количество кластеров K', fontsize=12)
ax.set_ylabel('WCSS (сумма квадратов расстояний)', fontsize=12)
ax.set_title('Метод "локтя" для определения оптимального K', fontsize=14)
ax.grid(True, alpha=0.3)
ax.axvline(x=K, color='red', linestyle='--', linewidth=2, label=f'Выбранное K = {K}')
ax.legend()

plt.tight_layout()
plt.show()

print(f"\nОптимальное K по методу 'локтя' находится в точке изгиба графика")
print(f"Для данного набора данных выбрано K = {K}")
